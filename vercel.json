{
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/drip",
      "schedule": "0 15 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/claude/:path*",
      "destination": "/lessons/claude/:path*",
      "permanent": true
    },
    {
      "source": "/chatgpt/:path*",
      "destination": "/lessons/chatgpt/:path*",
      "permanent": true
    },
    {
      "source": "/copilot/:path*",
      "destination": "/lessons/copilot/:path*",
      "permanent": true
    },
    {
      "source": "/foundations/:path*",
      "destination": "/lessons/foundations/:path*",
      "permanent": true
    },
    {
      "source": "/gemini/:path*",
      "destination": "/lessons/gemini/:path*",
      "permanent": true
    },
    {
      "source": "/perplexity/:path*",
      "destination": "/lessons/perplexity/:path*",
      "permanent": true
    },
    {
      "source": "/lessons/seniors",
      "destination": "/seniors",
      "permanent": true
    }
  ],
  "functions": {
    "api/playground.js": {
      "maxDuration": 30
    },
    "api/waitlist.js": {
      "maxDuration": 10
    },
    "api/webhooks/stripe.js": {
      "maxDuration": 10
    },
    "api/drip.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html"
        }
      ]
    }
  ]
}