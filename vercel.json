    },
    "api/waitlist.js": {
      "maxDuration": 10
    },
    "api/webhooks/stripe.js": {
      "maxDuration": 10
    },
    "api/drip.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html"
        }
      ]
    }
