{
  "cleanUrls": true,
  "functions": {
    "api/playground.js": {
      "maxDuration": 30
    },
    "api/waitlist.js": {
      "maxDuration": 10
    },
    "api/webhooks/stripe.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript"
        }
      ]
    }
  ]
}
